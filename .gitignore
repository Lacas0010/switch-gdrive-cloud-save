# ------------------------------------------------------------------------------
config.json
*.key
*.p12
*.pfx
auth_request.txt
state.json
!config.example.json

# ------------------------------------------------------------------------------
# Arquivos Temporarios e Logs de Runtime (Horizon OS / SDMC)
# ------------------------------------------------------------------------------
temp/
pending/
backups/
sdmc/
temp_check/
temp_switch_logs/
temp_drain/
temp_verify/
mtp_verify/
tests_tmp_zip/
tests_tmp_rollback/

*.log
sync.log
restore.log
*.bak
*.tmp
*.swp

# ------------------------------------------------------------------------------
# Python & Test Runner Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# IDEs e Ambientes de Desenvolvimento
